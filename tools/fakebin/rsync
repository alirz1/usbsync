#!/usr/bin/env python3
# Test double for rsync 3.x: honours the options USB Sync uses and prints
# --out-format "%i %l %n" items (incl. unchanged with -ii), progress2 and stats.
import sys, os, shutil, time
a=sys.argv[1:]
opt=lambda k: any(x==k or x.startswith(k+"=") for x in a)
val=lambda k: next((x.split("=",1)[1] for x in a if x.startswith(k+"=")),None)
dry=opt('--dry-run'); paths=[x for x in a if not x.startswith('-')]
srcs,dest=paths[:-1],paths[-1].rstrip('/')
ex=[x.split("=",1)[1] for x in a if x.startswith("--exclude=")]
def unit(v): return float(v[:-1])*{'K':1024,'M':1<<20,'G':1<<30}[v[-1]] if v else None
mn,mx=unit(val('--min-size')),unit(val('--max-size'))
items=[]  # (abs, rel)
ff=val('--files-from')
if ff:
    base=srcs[0].rstrip('/')
    for rel in open(ff,'rb').read().split(b'\0'):
        if rel: rel=rel.decode(); items.append((os.path.join(base,rel),rel))
else:
    for s in srcs:
        base=s.rstrip('/') if s.endswith('/') else os.path.dirname(s.rstrip('/'))
        for r,ds,fs in os.walk(s):
            ds[:]=[d for d in ds if d not in ex]; ds.sort()
            rd=os.path.relpath(r,base)
            items.append((r,"./" if rd=="." else rd+"/"))
            for f in sorted(fs):
                if f in ex: continue
                items.append((os.path.join(r,f),os.path.join(rd,f)))
files=[i for i in items if not i[1].endswith('/')]
total=sum(os.path.getsize(p) for p,_ in files) or 1; done=0; x=0
for i,(p,rel) in enumerate(items):
    d=os.path.normpath(os.path.join(dest,rel))
    if rel.endswith('/'):
        print(("cd+++++++++" if not os.path.isdir(d) else ".d         ")+" 4096 "+rel, flush=True)
        if not dry: os.makedirs(d,exist_ok=True)
        continue
    st=os.stat(p); sz=st.st_size
    if (mn and sz<mn) or (mx and sz>mx): continue
    if not os.path.exists(d):
        if opt('--existing'): continue
        code=">f+++++++++"
    else:
        if opt('--ignore-existing'): continue
        dt=os.stat(d); s_diff=dt.st_size!=sz; t_diff=abs(dt.st_mtime-st.st_mtime)>int(val('--modify-window') or 0)
        if opt('--update') and dt.st_mtime>st.st_mtime: continue
        if opt('--size-only'): t_diff=False
        if opt('--ignore-times'): s_diff=s_diff or True
        if opt('--checksum'):
            c=open(p,'rb').read()!=open(d,'rb').read(); code=">fc"+("s" if s_diff else ".")+("t" if t_diff else ".")+"......" if c else ".f         "
        elif s_diff or t_diff: code=">f."+("s" if s_diff else ".")+("t" if t_diff else ".")+"......"
        else: code=".f         "
    print(f"{code} {sz} {rel}", flush=True)
    if code.startswith('>'):
        x+=1
        if not dry: os.makedirs(os.path.dirname(d),exist_ok=True); shutil.copy2(p,d)
        done+=sz; time.sleep(0.15)
        sys.stdout.write("%15s %3d%%   12.34MB/s    0:00:02 (xfr#%d, to-chk=%d/%d)\r" % (f"{done:,}", done*100//total, x, len(files)-i, len(files))); sys.stdout.flush()
if opt('--delete') and not ff:
    srcrels={r.rstrip('/') for _,r in items}
    for s in srcs:
        top="" if s.endswith('/') else os.path.basename(s.rstrip('/'))
        for r,ds,fs in os.walk(os.path.join(dest,top)):
            for f in fs:
                rel=os.path.relpath(os.path.join(r,f),dest)
                if rel.startswith("./"): rel=rel[2:]
                if rel not in srcrels:
                    print(f"*deleting 0 {rel}")
                    if not dry: os.remove(os.path.join(dest,rel))
print("\nNumber of files: %d\nNumber of regular files transferred: %d\nTotal transferred file size: %s bytes" % (len(files),x,f"{done:,}"))
